# Copy to .env and fill in your values
# Used by docker-compose.yml and docker-compose.full.yml
#
# Docpipe reads DOCPIPE_* via pydantic-settings. Provider API keys use
# standard names (OPENAI_API_KEY, etc.) — not DOCPIPE_-prefixed.

# --- Provider API keys (set the ones you use) ---
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# --- Database (pgvector; matches compose db service) ---
DOCPIPE_DB_CONNECTION_STRING=postgresql://docpipe:docpipe@db:5432/docpipe
DOCPIPE_DB_TABLE_NAME=documents

# --- Embeddings & LLM defaults (for server / health probes) ---
DOCPIPE_EMBEDDING_PROVIDER=openai
DOCPIPE_EMBEDDING_MODEL=text-embedding-3-small
# DOCPIPE_EMBEDDING_PROVIDER=google
# DOCPIPE_EMBEDDING_MODEL=models/text-embedding-004

DOCPIPE_LLM_PROVIDER=openai
DOCPIPE_LLM_MODEL=gpt-4o

# --- Vector store backend ---
DOCPIPE_VECTOR_BACKEND=pgvector
# DOCPIPE_VECTOR_BACKEND=turbovec
# DOCPIPE_TURBVEC_INDEX_DIR=./.docpipe/indices
# DOCPIPE_TURBVEC_BIT_WIDTH=4

# --- Install profile & plugin defaults (v0.6+) ---
# DOCPIPE_PROFILE=balanced
# DOCPIPE_DEFAULT_PARSER=auto
# DOCPIPE_DEFAULT_PARSER_TIER=balanced
# DOCPIPE_DEFAULT_CHUNKER=recursive
# DOCPIPE_DEFAULT_RERANKER=none
# DOCPIPE_DEFAULT_RAG_STRATEGY=naive
# DOCPIPE_DEFAULT_RUNTIME_PRESET=balanced
# DOCPIPE_DISABLED_PLUGINS=pymupdf,mineru
# DOCPIPE_ENABLED_PARSERS=markitdown,docling

# --- Ingestion defaults ---
# DOCPIPE_CHUNK_SIZE=1000
# DOCPIPE_CHUNK_OVERLAP=200
# DOCPIPE_INGEST_MODE=both

# --- Resource usage (align with docker-compose deploy.resources limits) ---
# DOCPIPE_MAX_CONCURRENCY=2

# --- Server ---
# DOCPIPE_SERVER_HOST=0.0.0.0
# DOCPIPE_SERVER_PORT=8000
# DOCPIPE_LOG_LEVEL=INFO
# DOCPIPE_LOG_FORMAT=text
# DOCPIPE_HTTP_REQUEST_LOGGING_ENABLED=true

# --- Performance & caching ---
# DOCPIPE_MODEL_CACHE_DIR=/var/cache/docpipe
# DOCPIPE_PARSER_CACHE_TTL_SECONDS=300
# DOCPIPE_RATE_LIMIT_ENABLED=true

# --- Multi-tenant plugin policy (JSON) ---
# DOCPIPE_TENANT_PLUGIN_POLICIES={"tenant-a":{"enabled_parsers":"markitdown,docling"}}

# --- Phoenix eval tracing (pip install docpipe-sdk[phoenix]) ---
# DOCPIPE_PHOENIX_ENABLED=false
# DOCPIPE_PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# --- Control-plane DB (optional metadata; not your vector/RAG data) ---
# Enabled by default in docker-compose.yml with SQLite at /data/docpipe.db
# DOCPIPE_CONTROL_DB_ENABLED=false
# DOCPIPE_CONTROL_DB_URL=sqlite:////data/docpipe.db
# DOCPIPE_CONTROL_DB_PATH=/data/docpipe.db
# DOCPIPE_CONTROL_DB_AUTO_MIGRATE=true
# DOCPIPE_ADMIN_PANEL_ENABLED=true
# DOCPIPE_PERSIST_AUDIT_EVENTS=false
# DOCPIPE_PERSIST_INGEST_JOBS=false
# DOCPIPE_PERSIST_PLUGIN_RESOLUTIONS=false
# DOCPIPE_ADMIN_USERNAME=admin
# DOCPIPE_ADMIN_PASSWORD=docpipe
# DOCPIPE_ADMIN_EMAIL=admin@localhost

# --- Security ---
DOCPIPE_AUTH_ENABLED=true
DOCPIPE_USERNAME=admin
DOCPIPE_PASSWORD=docpipe
# Set true when ingest sources are MinIO/internal URLs (Docker sidecars)
DOCPIPE_ALLOW_PRIVATE_URLS=false

# --- Observability (pip install docpipe-sdk[observability]) ---
DOCPIPE_OTEL_ENABLED=false
DOCPIPE_OTEL_SERVICE_NAME=docpipe
DOCPIPE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# DOCPIPE_OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20token
# DOCPIPE_OTEL_TRACES_SAMPLER=parentbased_traceidratio
DOCPIPE_OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
DOCPIPE_HEALTH_CHECK_DB=true
DOCPIPE_HEALTH_CHECK_EMBEDDING=false

# --- Speech-to-text (POST /transcribe; pip install docpipe-sdk[openai] for Whisper) ---
# DOCPIPE_TRANSCRIBE_DEFAULT_BACKEND=openai
# DOCPIPE_TRANSCRIBE_DEFAULT_BACKEND=vibevoice
# DOCPIPE_VIBEVOICE_MODEL_PATH=microsoft/VibeVoice-ASR
# DOCPIPE_VIBEVOICE_DEVICE=auto
# Proxy to a GPU host running docpipe with vibevoice loaded:
# DOCPIPE_TRANSCRIBE_DEFAULT_BACKEND=vibevoice_remote
# DOCPIPE_VIBEVOICE_SERVICE_URL=http://vibevoice-gpu:8000
