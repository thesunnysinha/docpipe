# Internal shared docpipe — copy to .env and edit.
# See ../README.md for full flag reference.

OPENAI_API_KEY=sk-...

# Auth (required on shared host)
DOCPIPE_AUTH_ENABLED=true
DOCPIPE_USERNAME=admin
DOCPIPE_PASSWORD=change-me-internal

# Control-plane SQLite at ./data/docpipe.db (admin + optional audit)
DOCPIPE_CONTROL_DB_ENABLED=true
DOCPIPE_ADMIN_PANEL_ENABLED=true
DOCPIPE_PERSIST_AUDIT_EVENTS=true
DOCPIPE_PERSIST_INGEST_JOBS=false
DOCPIPE_PERSIST_PLUGIN_RESOLUTIONS=false

# Internal Docker / MinIO / cluster URLs as document sources
DOCPIPE_ALLOW_PRIVATE_URLS=true

# Server defaults (health probe only — apps pass their own connection_string)
# DOCPIPE_DB_CONNECTION_STRING=postgresql://delegate:pass@delegate-db:5432/delegate
DOCPIPE_EMBEDDING_PROVIDER=openai
DOCPIPE_EMBEDDING_MODEL=text-embedding-3-small

DOCPIPE_PROFILE=balanced
DOCPIPE_MAX_CONCURRENCY=2
DOCPIPE_HOST_PORT=8000
DOPIPE_IMAGE_TAG=balanced
