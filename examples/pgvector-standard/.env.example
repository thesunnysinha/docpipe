# pgvector local stack — copy to .env

OPENAI_API_KEY=your-openai-api-key

DOCPIPE_AUTH_ENABLED=true
DOCPIPE_USERNAME=admin
DOCPIPE_PASSWORD=docpipe

# Matches compose db service
DOCPIPE_DB_CONNECTION_STRING=postgresql://docpipe:docpipe@db:5432/docpipe
DOCPIPE_DB_TABLE_NAME=documents
DOCPIPE_VECTOR_BACKEND=pgvector

DOCPIPE_EMBEDDING_PROVIDER=openai
DOCPIPE_EMBEDDING_MODEL=text-embedding-3-small

DOCPIPE_CONTROL_DB_ENABLED=true
DOCPIPE_PERSIST_AUDIT_EVENTS=true
DOCPIPE_PERSIST_INGEST_JOBS=false

# false unless parsing MinIO/internal HTTP URLs
DOCPIPE_ALLOW_PRIVATE_URLS=false

DOCPIPE_PROFILE=balanced
DOCPIPE_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
DOPIPE_IMAGE_TAG=balanced
