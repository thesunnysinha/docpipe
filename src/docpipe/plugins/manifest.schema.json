{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docpipe.dev/schemas/plugin-manifest-v1.json",
  "title": "Docpipe Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plugins"],
  "properties": {
    "schema_version": {"const": 1},
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/plugin"}
    }
  },
  "$defs": {
    "stableName": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "category", "description"],
      "properties": {
        "name": {"$ref": "#/$defs/stableName"},
        "category": {"enum": ["source", "vectorstore"]},
        "description": {"type": "string", "minLength": 1},
        "implementation_version": {"type": "string", "minLength": 1},
        "extra": {"$ref": "#/$defs/stableName"},
        "package": {"type": "string", "minLength": 1},
        "api_min": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "api_max": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableName"}
        },
        "runtime_requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["cpu", "gpu", "external-service", "local-binary"]}
        },
        "stability": {"enum": ["experimental", "beta", "stable", "deprecated"]},
        "license_id": {"type": "string", "minLength": 1},
        "license_note": {"type": "string", "minLength": 1},
        "deprecated": {"type": "boolean"},
        "deprecation_message": {"type": "string", "minLength": 1}
      }
    }
  }
}
